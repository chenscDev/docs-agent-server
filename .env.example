# 通义千问（OpenAI 兼容模式）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=替换为你的千问API_Key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 客户端访问 Token（P2-D4 / P3-D13）
# - API_TOKEN：兼容单 Token
# - API_TOKENS：多个有效 Token（逗号分隔），与 API_TOKEN 并集
# - API_TOKENS_REVOKED：作废列表（逗号分隔）
# - 亦可写 data/api_tokens_revoked.local（每行一个，改文件热生效）
# /health 不校验。勿把真实生产 Token 提交进仓库。
API_TOKEN=dev-local-token
API_TOKENS=
API_TOKENS_REVOKED=
# API_TOKENS_REVOKED_FILE=./data/api_tokens_revoked.local

DATABASE_URL=sqlite:///./data/docs_agent.db

UPLOAD_DIR=./data/uploads
EXTRACTED_DIR=./data/extracted
MAX_UPLOAD_MB=20

CHUNK_SIZE=500
CHUNK_OVERLAP=80

FAISS_DIR=./data/faiss
EMBEDDING_BATCH_SIZE=10

# P3-D1 检索重排（云 API 失败时本地启发式兜底）
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_CANDIDATE_K=20

# P3-D2 引用：默认 false=正文无 [n] 不挂假 citation；演示可 true
CITATION_FALLBACK_TOP3=false

# P3-D11 FAISS 增量（失败自动全量 rebuild）
FAISS_INCREMENTAL=true

# AI 短视频（/v1/video/*）
# VIDEO_RENDERER=auto|remotion|lambda|ffmpeg
# auto：本机 Remotion →（若开启）Lambda → FFmpeg
VIDEO_RENDERER=auto
VIDEO_OUTPUT_DIR=./data/video_out
# 公网 CDN 前缀；空则返回相对路径 /cdn/video/xxx.mp4
# VIDEO_PUBLIC_BASE_URL=http://47.93.207.70
REMOTION_PROJECT_DIR=./video-renderer
VIDEO_RENDER_TIMEOUT_SEC=300
# 本机 Remotion：2G 演示机建议 concurrency=1、堆约 768MB
REMOTION_CONCURRENCY=1
REMOTION_NODE_MAX_OLD_SPACE_MB=768
# Remotion Lambda（可选：只替换 render hop；Job/SSE/TTS/RN 不变）
# 1) 在 AWS 部署 Remotion Lambda function + site（见 Remotion 官方文档）
# 2) video-renderer: npm i && 确保已装 @remotion/lambda
# 3) 打开开关并填齐三项；内存紧时可 PREFER_LAMBDA=true
REMOTION_LAMBDA_ENABLED=false
REMOTION_PREFER_LAMBDA=false
# REMOTION_LAMBDA_REGION=us-east-1
# REMOTION_LAMBDA_FUNCTION_NAME=remotion-render-xxxxx
# REMOTION_LAMBDA_SERVE_URL=https://xxx.s3.amazonaws.com/sites/ai-video
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# TTS 配音（DashScope CosyVoice）；失败自动静音
VIDEO_TTS_ENABLED=true
VIDEO_TTS_MODEL=cosyvoice-v2
VIDEO_TTS_VOICE=longxiaochun_v2
# 画面说明 → 文生图（通义万相 wanx-v1）；失败回退占位图
VIDEO_T2I_ENABLED=true
VIDEO_T2I_MODEL=wanx-v1
VIDEO_T2I_SIZE=720*1280
# 可选镜像目录；nginx 已反代 /cdn/video 时可留空
# VIDEO_CDN_MIRROR_DIR=/var/www/rn-cdn/video
# dashscope SDK（可选，TTS / 文生图用）：pip install dashscope

