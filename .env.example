# 通义千问（OpenAI 兼容模式）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=替换为你的千问API_Key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 客户端访问 Token（P2-D4）；非空则业务 API 须带 Authorization: Bearer <值>
# /health 不校验。勿把真实生产 Token 提交进仓库。
API_TOKEN=dev-local-token

DATABASE_URL=sqlite:///./data/docs_agent.db

UPLOAD_DIR=./data/uploads
EXTRACTED_DIR=./data/extracted
MAX_UPLOAD_MB=20

CHUNK_SIZE=500
CHUNK_OVERLAP=80

FAISS_DIR=./data/faiss
EMBEDDING_BATCH_SIZE=10
